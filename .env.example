# Server (Vercel env or local server.mjs / vercel dev)
# Cheff public URL: prefer GEMINI_API_KEY (Google AI Studio free quota)
GEMINI_API_KEY=
# Or DeepSeek (cheap; matches Cheff portco story)
DEEPSEEK_API_KEY=
# Default if unset: gemini-3.1-flash-lite-preview (less 503 than 3.8-flash)
# HARBOR_MODEL=gemini-3.1-flash-lite-preview
# HARBOR_MODEL=gemini-3.8-flash
# HARBOR_MODEL=deepseek-chat
# Optional: require X-Demo-Token on POST /api/run
# DEMO_TOKEN=

# Client (Vite — prefix VITE_)
# Cheff Vercel deploy: leave Supabase vars unset (localStorage; avoids free-tier pause)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

PORT=3848
